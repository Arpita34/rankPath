# Required: get it at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: defaults to claude-opus-5-5
# CLAUDE_MODEL=claude-opus-5-5

# Optional but needed for a persistent deployed demo (Supabase → Project Settings → API).
# Without these, leads are saved to data/leads.local.json (local) or /tmp (Vercel, temporary).
# Use the SECRET key (sb_secret_...), not the publishable one: it is only used server-side.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional: real WhatsApp sending via the Twilio WhatsApp Sandbox.
# Without these, WhatsApp messages are generated and shown on the dashboard as "simulated".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
